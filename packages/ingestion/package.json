    "test:unit": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
