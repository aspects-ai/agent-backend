{
  "name": "@agentbe/room",
  "version": "0.0.0",
  "private": true,
  "description": "Agent document room \u2014 service layer composing agent-backend + versioned-store + index-sync into the search \u2192 checkout \u2192 exec \u2192 commit loop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentbe-room-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "testdata"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@agentbe/versioned-store": "workspace:*",
    "@agentbe/index-sync": "workspace:*",
    "@agentbe/embeddings": "workspace:*",
    "@agentbe/ingestion": "workspace:*",
    "@agentbe/vector-pg": "workspace:*",
    "agent-backend": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@huggingface/transformers": "^3.0.0",
    "pg": "^8.23.0",
    "zod": "^3.24.1",
    "@aws-sdk/client-s3": "^3.1120.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
