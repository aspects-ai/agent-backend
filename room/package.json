{
  "name": "@agentbe/room",
  "version": "0.0.0",
  "private": true,
  "description": "Agent document room — service layer composing agent-backend + versioned-store + index-sync into the search → checkout → exec → commit loop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@agentbe/versioned-store": "workspace:*",
    "@agentbe/index-sync": "workspace:*",
    "agent-backend": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
